# FinalRelease local configuration.
# Real keys are already embedded as defaults in application.properties,
# so the app runs out of the box. Sourcing this file keeps behavior identical.

# Database and authentication
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/english_learning_copilot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
APP_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_OR_LONGER_SECRET

# Speaking agent (SJTU OpenAI-compatible endpoint)
SPEAKING_AGENT_PROVIDER=sjtu
SJTU_AI_ENDPOINT=https://models.sjtu.edu.cn/api/v1
SJTU_AI_API_KEY=sk-PRnW2uK3s_v6s4WGKxlk2g
SJTU_AI_MODEL=deepseek-chat

# Xfyun ASR (speech recognition)
XFYUN_ASR_ENABLED=true
XFYUN_APP_ID=609507a1
XFYUN_API_KEY=1b5e86adfb9d5c5d9a89fcaea4b0c9d4
XFYUN_API_SECRET=YTNmZWQ2ZGQ0MDZkYWRmZjZiNmUzZTVl

# Xfyun ISE (pronunciation evaluation), same credential set
XFYUN_ISE_ENABLED=true
XFYUN_ISE_APP_ID=609507a1
XFYUN_ISE_API_KEY=1b5e86adfb9d5c5d9a89fcaea4b0c9d4
XFYUN_ISE_API_SECRET=YTNmZWQ2ZGQ0MDZkYWRmZjZiNmUzZTVl

# TTS disabled: agent playback uses browser SpeechSynthesis
SUPERSMART_TTS_ENABLED=false
